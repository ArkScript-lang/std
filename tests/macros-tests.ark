(import std.Macros)
(import std.Testing)

(let f1 (fun (data)
  (+ data "-f1")))
(let f2 (fun (data)
  (+ data "-f2")))
(let f3 (fun (data)
  (+ data "-f3")))
(let foo (fun (data f)
  (f data)))

(let test_func (fun (a b c) (* a b c)))
(let test_func1 (partial test_func 1))
(let test_func2 (partial test_func1 2))
(let test_func3 (partial2 test_func 1 _ 3))
(let test_func4 (partial2 test_func _ 2 _))
(let db (dict
  "tables" (dict
    "users" (dict
      "lexy" "dev"))))
(let db2 (dict
  "tables" (dict
    "users" nil)))
(let db3 (dict
  "tables" nil))

(test:suite macros {
  (test:case "->" {
    (test:eq (-> "f0" f1) "f0-f1")
    (test:eq (-> "f0" f1 f2 f3) "f0-f1-f2-f3")
    (test:eq (-> "f0" f1 (foo _ f2) (foo _ f3)) "f0-f1-f2-f3") })

  (test:case "some->" {
    (test:eq (some-> db (@ _ "tables") (@ _ "users") (@ _ "lexy")) "dev")
    (test:eq (some-> db2 (@ _ "tables") (@ _ "users") (@ _ "lexy")) nil)
    (test:eq (some-> db3 (@ _ "tables") (@ _ "users") (@ _ "lexy")) nil)
    (test:eq (some-> nil (@ _ "tables") (@ _ "users") (@ _ "lexy")) nil) })

  (test:case "fun->" {
    (mut fun_thread (fun-> f1))
    (test:eq (fun_thread "f0") "f0-f1")

    (mut fun_thread (fun-> f1 f2 f3))
    (test:eq (fun_thread "f0") "f0-f1-f2-f3")

    (mut fun_thread (fun-> f1 (foo _ f2) (foo _ f3)))
    (test:eq (fun_thread "f0") "f0-f1-f2-f3") })

  (test:case "partial & partial2" {
    (test:eq (test_func1 2 3) 6)
    (test:eq ($argcount test_func1) 2)
    (test:eq ($argcount test_func2) 1)
    (test:eq ($argcount test_func4) 2)
    (test:eq (test_func3 2) 6)
    (test:eq (test_func4 1 3) 6) })

  (test:case "unless" {
    (unless false
      (test:expect true "unless true worked")
      (test:expect false "this shouldn't trigger"))

    (unless (= "abracadabra" (f1 "f0"))
      (test:expect true)
      (test:expect false "this shouldn't trigger"))

    (unless true
      (test:expect true "unless with one argument")) })

  (test:case "until" {
    (mut i 0)
    (until (= i 10) {
      (set i (+ 1 i)) })
    (test:eq i 10)

    (until true
      (test:expect false "this shouldn't trigger")) })

  (test:case "unpack" {
    (unpack [1 2 3] a b c)
    (test:eq a 1)
    (test:eq b 2)
    (test:eq c 3)

    (unpack [4 5 6] d e)
    (test:eq d 4)
    (test:eq e 5) })

  (test:case "++ and --" {
    (mut i 0)
    (test:eq (++ i) 1)
    (test:eq (++ i) 2)
    (test:eq (++ i) 3)
    (test:eq (-- i) 2)
    (test:eq (-- i) 1)
    (test:eq (-- i) 0)
    (test:eq (-- i) -1) })

  (test:case "let* and mut*" {
    (let* (m1 1) (m2 (+ m1 2)) (m3 (+ m2 m1)))
    (test:eq m1 1)
    (test:eq m2 3)
    (test:eq m3 4)

    (mut* (m4 1) (m5 (+ m4 2)) (m6 m4))
    (test:eq m4 1)
    (test:eq m5 3)
    (test:eq m6 1)
    (mut m6 2)
    (test:eq m6 2)

    (set* (m4 2) (m5 3) (m6 4))
    (test:eq m4 2)
    (test:eq m5 3)
    (test:eq m6 4) }) })
